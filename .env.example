DATABASE_URL=postgresql+psycopg2://invoice_user:invoice_password@localhost:5432/invoice_dashboard

# Outlook provider:
# win32 = local Windows Outlook desktop app using pywin32
# graph = Microsoft Graph API
OUTLOOK_PROVIDER=win32

OUTLOOK_SUBJECT_REFERENCE=AP BTS Weekly Report
OUTLOOK_MAIL_FOLDER=inbox
OUTLOOK_SCAN_LIMIT=250
OUTLOOK_SCAN_TIMEZONE=Africa/Johannesburg
OUTLOOK_SCAN_ENABLED=true
OUTLOOK_DOWNLOAD_DIR=data/outlook_downloads

# Optional for win32 if your target inbox is not the default inbox.
# Example: Mailbox - Finance Team/Inbox
OUTLOOK_WIN32_FOLDER_PATH=

# Microsoft Graph / Outlook, only needed when OUTLOOK_PROVIDER=graph.
OUTLOOK_TENANT_ID=common
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_USER_ID=
OUTLOOK_TOKEN_CACHE_PATH=data/outlook/token_cache.bin
OUTLOOK_SCOPES=Mail.Read
